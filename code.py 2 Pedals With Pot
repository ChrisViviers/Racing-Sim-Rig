import board
import busio
import digitalio
import analogio
import time
import usb_hid
from hid_gamepad import Gamepad
import adafruit_as5600
 
# ==========================================
# 1. HARDWARE CALIBRATION
# ==========================================
THROTTLE_REST    = 800
THROTTLE_FLOORED = 23300
BRAKE_REST       = 3400
BRAKE_FLOORED    = 24000
 
STEERING_CENTER  = 1030
SENSOR_RANGE     = 4096
MAX_SWEEP        = 1675
 
# ==========================================
# 2. INITIALIZATION
# ==========================================
gamepad = Gamepad(usb_hid.devices)
 
i2c = busio.I2C(board.GP1, board.GP0)
as5600 = adafruit_as5600.AS5600(i2c)
 
throttle_pin = analogio.AnalogIn(board.GP26)
brake_pin    = analogio.AnalogIn(board.GP27)
 
 
def init_button(pin):
    btn = digitalio.DigitalInOut(pin)
    btn.direction = digitalio.Direction.INPUT
    btn.pull = digitalio.Pull.UP
    return btn
 
 
buttons = [
    init_button(board.GP6),
    init_button(board.GP7),
    init_button(board.GP8),
    init_button(board.GP9),
    init_button(board.GP10),
    init_button(board.GP11),
    init_button(board.GP12),
    init_button(board.GP13)
]
 
# ==========================================
# 3. MAPPING FUNCTIONS
# ==========================================
def map_pedal(x, in_rest, in_floored):
    if in_rest < in_floored:
        clamped = max(in_rest, min(x, in_floored))
        scaled = (clamped - in_rest) * 255.0 / (in_floored - in_rest)
    else:
        clamped = min(in_rest, max(x, in_floored))
        scaled = (in_rest - clamped) * 255.0 / (in_floored - in_rest)
    return int(max(0, min(255, scaled)))
 
 
def get_steering_axis(raw_angle):
    diff = raw_angle - STEERING_CENTER
 
    if diff > SENSOR_RANGE / 2:
        diff -= SENSOR_RANGE
    elif diff < -SENSOR_RANGE / 2:
        diff += SENSOR_RANGE
 
    clamped_diff = max(-MAX_SWEEP, min(MAX_SWEEP, diff))
    scaled = int((clamped_diff / float(MAX_SWEEP)) * 127)
    return max(-127, min(127, scaled))
 
 
# ==========================================
# 4. MAIN LOOP
# ==========================================
print("Controller Active on Report ID 5!")
 
last_steering_hid = 0
 
while True:
    # Steering
    try:
        last_steering_hid = get_steering_axis(as5600.angle)
    except Exception:
        pass
    steering_hid = last_steering_hid
 
    # Pedals
    throttle_hid = map_pedal(throttle_pin.value, THROTTLE_REST, THROTTLE_FLOORED)
    brake_hid    = map_pedal(brake_pin.value, BRAKE_REST, BRAKE_FLOORED)
 
    # Buttons
    button_mask = 0
    for i, btn in enumerate(buttons):
        if not btn.value:
            button_mask |= (1 << i)
 
    # Transmit
    gamepad.report(buttons=button_mask, x=steering_hid, y=throttle_hid, z=brake_hid, rz=0)
 
    time.sleep(0.005)
